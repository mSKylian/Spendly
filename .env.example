# =====================================================================
# Firebase configuration (client + server)
# ---------------------------------------------------------------------
# Copy the values from the Firebase console:
#   Project settings > Your apps > Web app > SDK setup and configuration
# These VITE_-prefixed vars are read by the client (import.meta.env) AND
# by the Express server (process.env). Firebase web config values are
# public by design — access is enforced by firestore.rules, not secrecy.
# =====================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional. Leave empty to use the (default) Firestore database.
VITE_FIREBASE_DATABASE_ID=""
# Optional. Only needed if you use Google Analytics.
VITE_FIREBASE_MEASUREMENT_ID=""

# =====================================================================
# Server secrets
# =====================================================================
# SERVER_ENCRYPTION_KEY: REQUIRED. Encrypts the admin LLM API key at rest.
# Must be at least 64 hex characters — the server refuses to start otherwise.
# Generate a fresh one (do NOT reuse a placeholder):
#   openssl rand -hex 32
SERVER_ENCRYPTION_KEY=""

# GEMINI_API_KEY: Optional. Fallback Gemini key used only when no LLM provider
# is configured in the admin panel. Leave empty to require admin configuration.
GEMINI_API_KEY=""

# APP_URL: Public URL where this applet is hosted. Used for self-referential
# links and OAuth callbacks. Defaults to http://localhost:3000 in development.
APP_URL="http://localhost:3000"
